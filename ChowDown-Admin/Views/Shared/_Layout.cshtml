<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CHOWDOWN Admin</title>
    <script type="importmap"></script>


    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

 
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CHOWDOWN.styles.css" asp-append-version="true" />
</head>
<body>
   
    <header>
        <div class="container">
            <div class="top-nav">
              
                <div class="logo">
                    <img src="~/images/chowdown.jpg" alt="Chow Down" style="height: 40px; margin-right: 10px; vertical-align: middle;" />
                    CHOW DOWN
                    <span style="font-size:0.7rem; color:#e63946; background:#1e1e1e; padding:2px 10px; border-radius:20px; margin-left:8px;">ADMIN</span>
                </div>

                <div class="nav-links">
                    <a asp-controller="Admin" asp-action="Dashboard">
                        <i class="fas fa-chart-pie"></i> Dashboard
                    </a>
                    <a asp-controller="Admin" asp-action="Inventory">
                        <i class="fas fa-boxes"></i> Inventory
                    </a>
                    <a asp-controller="Admin" asp-action="StockEntry">
                        <i class="fas fa-plus-circle"></i> Add Stock
                    </a>
                    <a asp-controller="Admin" asp-action="Orders">
                        <i class="fas fa-shopping-cart"></i> Orders
                    </a>
                    <a asp-controller="Admin" asp-action="Reports">
                        <i class="fas fa-file-alt"></i> Reports
                    </a>
                    <a asp-controller="Admin" asp-action="Promotions">
                        <i class="fas fa-bullhorn"></i> Promotions
                    </a>
                    <a asp-controller="Admin" asp-action="Logout" style="color: #e63946;">
                        <i class="fas fa-sign-out-alt"></i> Logout
                    </a>
                </div>
            </div>
        </div>
    </header>


    <div class="container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    
    <footer>
        <div class="container">
            <div class="footer-mini">
                <div>
                    
                    <img src="~/images/chowdown.jpg" alt="Chow Down" style="height: 20px; vertical-align: middle; margin-right: 8px;" />
                    CHOW DOWN ADMIN PANEL © 2024
                </div>
                <div class="social-icons">
                    <span><i class="fas fa-headset"></i> SUPPORT</span>
                    <span><i class="fas fa-lock"></i> PRIVACY</span>
                </div>
            </div>
        </div>
    </footer>

   
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@{
    ViewData["Title"] = "Promotions - Admin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 style="margin-bottom: 1rem;"><i class="fas fa-bullhorn"></i> Promotions</h2>

<div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem;">
    <button class="btn"><i class="fas fa-plus"></i> Create New Post</button>
</div>

<div class="card">
    <h4 style="margin-bottom: 1rem;">Recent Promotions</h4>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem;">
        <div style="background:#1e1e1e; border-radius:20px; padding:1.2rem; border:1px solid #2a2a2a;">
            <h5> NEW: Spicy Chicken Feet</h5>
            <p style="color:#999;">Limited time offer! Get 20% off</p>
            <span class="badge">Active</span>
            <div style="margin-top:0.8rem; display:flex; gap:0.5rem;">
                <button class="btn btn-sm">Edit</button>
                <button class="btn-outline btn btn-sm">Delete</button>
            </div>
        </div>
        <div style="background:#1e1e1e; border-radius:20px; padding:1.2rem; border:1px solid #2a2a2a;">
            <h5> Weekend Special</h5>
            <p style="color:#999;">Buy 2 burgers, get 1 free</p>
            <span class="badge" style="background:#ffc107;">Pending</span>
            <div style="margin-top:0.8rem; display:flex; gap:0.5rem;">
                <button class="btn btn-sm">Edit</button>
                <button class="btn-outline btn btn-sm">Delete</button>
            </div>
        </div>
        <div style="background:#1e1e1e; border-radius:20px; padding:1.2rem; border:1px solid #2a2a2a;">
            <h5>New: Secret Sauce 5L</h5>
            <p style="color:#999;">Now available in bulk</p>
            <span class="badge" style="background:#28a745;">Published</span>
            <div style="margin-top:0.8rem; display:flex; gap:0.5rem;">
                <button class="btn btn-sm">Edit</button>
                <button class="btn-outline btn btn-sm">Delete</button>
            </div>
        </div>
    </div>
</div>
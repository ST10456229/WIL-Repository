@{
    ViewData["Title"] = "Admin Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Chow Down Admin Login</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body style="background: #0b0b0b; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; padding: 2rem;">
    <div class="staff-access" style="max-width: 450px; width: 100%;">
        
        <div style="text-align: center; margin-bottom: 1.5rem;">
            <img src="~/images/chowdown.jpg" alt="Chow Down" style="height: 80px; margin-bottom: 0.5rem;" />
            <h3 style="color: #e63946; letter-spacing: 2px; font-weight: 300;"># CHOW DOWN</h3>
        </div>

        <h1>ADMIN LOGIN</h1>
        <div class="sub">Enter your credentials to manage the heat.</div>

        <div class="staff-form">
            <div class="field">
                <label>USERNAME <span style="color:#e63946;">*</span></label>
                <input type="text" placeholder="Enter username" />
            </div>
            <div class="field">
                <label>PASSWORD <span style="color:#e63946;">*</span></label>
                <input type="password" placeholder="Enter password" />
            </div>
            <div class="actions">
                <a asp-controller="Admin" asp-action="Dashboard" class="btn" style="width:100%; justify-content:center;">
                    <i class="fas fa-sign-in-alt"></i> LOGIN
                </a>
            </div>
            <div style="text-align:center; color:#888; font-size:0.8rem; margin-top:1rem;">
                <span>© 2024 CHOW DOWN. STREET FOOD CULTURE.</span>
            </div>
        </div>
    </div>
</body>
</html>
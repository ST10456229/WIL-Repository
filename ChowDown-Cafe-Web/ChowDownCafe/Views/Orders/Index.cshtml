@model IEnumerable<ChowDownCafe.Models.Order>

@{
    ViewData["Title"] = "Orders";

    var statuses = new[]
    {
        "Pending",
        "Preparing",
        "Ready",
        "Completed",
        "Cancelled"
    };

    var zar = System.Globalization.CultureInfo.GetCultureInfo("en-ZA");
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="fw-bold">Orders Management</h1>
            <p class="text-muted mb-0">
                View and manage customer orders for ChowDown Cafe.
            </p>
        </div>

        <div class="d-flex gap-2">
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="btn btn-outline-dark">
                Back to Dashboard
            </a>

            <a asp-controller="Orders"
               asp-action="Create"
               class="btn btn-dark">
                + Create Order
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No orders have been recorded yet.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <h5 class="mb-1">Total Orders: @Model.Count()</h5>
                <p class="text-muted mb-0">
                    Orders are displayed from newest to oldest.
                </p>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Contact Details</th>
                        <th>Date</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Update Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var order in Model)
                    {
                        var total = order.OrderItems.Sum(
                        item => item.Quantity * item.UnitPrice);

                        var badgeClass = order.OrderStatus switch
                        {
                            "Pending" => "bg-warning text-dark",
                            "Preparing" => "bg-primary",
                            "Ready" => "bg-info text-dark",
                            "Completed" => "bg-success",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                <strong>#@order.OrderId</strong>
                            </td>

                            <td>
                                <strong>@order.CustomerName</strong>

                                @if (!string.IsNullOrWhiteSpace(order.Notes))
                                {
                                    <div class="small text-muted mt-1">
                                        Notes: @order.Notes
                                    </div>
                                }
                            </td>

                            <td>
                                <div>
                                    @(order.CustomerEmail ?? "—")
                                </div>
                                <div class="small text-muted">
                                    @(order.CustomerPhone ?? "—")
                                </div>
                            </td>

                            <td>
                                @order.OrderDate.ToString("dd MMM yyyy")
                                <div class="small text-muted">
                                    @order.OrderDate.ToString("HH:mm")
                                </div>
                            </td>

                            <td>
                                @if (order.OrderItems.Any())
                                {
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var item in order.OrderItems)
                                        {
                                            <li class="mb-2">
                                                <strong>
                                                    @(item.Product?.ProductName
                                                                                        ?? $"Product #{item.ProductId}")
                                </strong>
                                <div class="small text-muted">
                                    Qty: @item.Quantity ×
                                    @item.UnitPrice.ToString("C2", zar)
                                </div>
                            </li>
                                                        }
                                    </ul>
                                }
                                else
                                {
                                    <span class="text-muted">No items</span>
                                }
                            </td>

                            <td class="text-nowrap">
                                <strong>@total.ToString("C2", zar)</strong>
                            </td>

                            <td>
                                <span class="badge @badgeClass">
                                    @order.OrderStatus
                                </span>
                            </td>

                            <td>
                                <form asp-controller="Orders"
                                      asp-action="UpdateStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="orderId"
                                           value="@order.OrderId" />

                                    <select name="orderStatus"
                                            class="form-select form-select-sm mb-2"
                                            required
                                            aria-label="Status for order @order.OrderId">

                                        @foreach (var status in statuses)
                                        {
                                            if (status == order.OrderStatus)
                                            {
                                                <option value="@status" selected>
                                                    @status
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@status">
                                                    @status
                                                </option>
                                            }
                                        }
                                    </select>

                                    <button type="submit"
                                            class="btn btn-sm btn-dark w-100">
                                        Update
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>
